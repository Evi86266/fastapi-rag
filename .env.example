# 复制为 .env 后填写本机配置。密钥留空可运行健康检查。
APP_NAME=FastAPI RAG
APP_HOST=127.0.0.1
APP_PORT=8000
# 分项级别留空时继承 LOG_LEVEL；级别不区分大小写。
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=
LOG_FILE_ENABLE=false
LOG_FILE_LEVEL=
# 每日零点后的下一条日志或达到大小阈值时轮转。
LOG_ROTATION_BYTES=5000000
# 1～36500 days；轮转时清理匹配日期日志，不是定时任务。
LOG_FILE_RETENTION=7 days
MILVUS_URL=http://192.168.10.150:19530
MILVUS_COLLECTION_PREFIX=fastapi_doc_chunks
BGE_M3_PATH=D:/S/zhangguizhiku/BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=D:/S/zhangguizhiku/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
RERANK_ENABLED=false
QWEN_MODEL=qwen-flash
QWEN_BASE_URL=
QWEN_API_KEY=
HISTORY_ENABLED=false
CORPUS_ARCHIVE_ENABLED=false
