# 复制为 .env 后填写本机配置。密钥留空可运行健康检查。
APP_NAME=FastAPI RAG
APP_HOST=127.0.0.1
APP_PORT=8000
# 分项级别留空时继承 LOG_LEVEL；级别不区分大小写。
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=
LOG_FILE_ENABLE=false
LOG_FILE_LEVEL=
# 每日零点后的下一条日志或达到大小阈值时轮转。
LOG_ROTATION_BYTES=5000000
# 1～36500 days；轮转时清理匹配日期日志，不是定时任务。
LOG_FILE_RETENTION=7 days
MILVUS_URL=
MILVUS_COLLECTION_PREFIX=fastapi_doc_chunks
BGE_M3_PATH=D:/S/zhangguizhiku/BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false
BGE_RERANKER_LARGE=D:/S/zhangguizhiku/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=false
RERANK_ENABLED=false
QWEN_MODEL=qwen-flash
QWEN_BASE_URL=
QWEN_API_KEY=
HISTORY_ENABLED=false
CORPUS_ARCHIVE_ENABLED=false

# Qwen 运行参数；持久费用台账绑定账期和预算，修改前须对账。
# 北京 qwen-flash 输入 <=128k 的标准价；变更模型/地域前必须重新核价。
COST_MONTH=
MONTHLY_BUDGET_CNY=100
MONTH_OPENING_SPENT_CNY=
QWEN_SAMPLE_BUDGET_CNY=1
QWEN_INPUT_CNY_PER_MILLION=0.15
QWEN_OUTPUT_CNY_PER_MILLION=1.5
QWEN_MAX_INPUT_TOKENS=4096
QWEN_MAX_OUTPUT_TOKENS=128
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=0

# false 仅用于隔离测试/只启动健康接口；真实运行默认 true。
EXTERNAL_ENABLED=true
MODEL_CPU_THREADS=2
BGE_MAX_LENGTH=512
RERANK_MAX_LENGTH=512
MILVUS_TIMEOUT_SECONDS=5
# 无认证留空；需要认证时填 token 或 user:password，不提交实际值。
MILVUS_TOKEN=
